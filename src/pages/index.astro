---
import Layout from "../layouts/Layout.astro"
// Supports weights 300-700
import '@fontsource-variable/fira-code';

import Button from "../components/ButtonSuscribe"

import Card from "../components/new-card.astro"

import CardSkills from "../components/card-skills.astro";

import bgimg from "../images/image.png"
import NavBar from "../components/nav-bar.astro";

---
<Layout title="EstebanDev | HOME">
	<div class="relative mx-auto h-full w-full max-w-7xl px-6 md:px-8 lg:px-12">
		<NavBar/>
		<div class="relative mx-auto flex flex-col items-center mt-40">
			<div class="grid justify-items-center mb-14">
				<div class="mb-8">
					<img src="https://avatars.githubusercontent.com/u/57014619" alt="" class="h-56 rounded-full">
				</div>
				<h1 class="text-white text-6xl font-bold text-center">Hola! Soy /Esteban/<br><!-- -->
					<span class="animate-text-gradient inline-flex bg-gradient-to-r from-neutral-900 via-slate-500 to-neutral-500 bg-[200%_auto] bg-clip-text leading-tight text-transparent dark:from-neutral-100 dark:via-slate-400 dark:to-neutral-400 text-3xl">Software Developer</span>
				</h1>
			</div>
			<div class="text-white max-w-4xl h-auto mb-28">
				<Card/>
			</div>

			<div class="max-w-4xl">
				<h1 class="text-white font-bold text-3xl text-center mb-1" >Habilidades</h1>
				<CardSkills/>
			</div>
		</div>
	</div>
</Layout>

