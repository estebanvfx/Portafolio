---
interface Props {
    title? : string,
    content? : string
}

const {title, content} = Astro.props
---
<style>
  .glow {
  animation: move 10s linear infinite;
  offset-path: rect(0% auto 100% auto);
  background: radial-gradient(#fff, #f1f5f9, transparent);
  }

  @keyframes move {
      0% {
          offset-distance: 0%;
      }

      100% {
          offset-distance: 100%;
      }
  }
</style>

<div class="overflow-hidden p-px relative rounded-2xl">
  <div class="glow inset-0 w-[50px] h-[50px] absolute rounded-full"></div>
  <div class=" p-5 inline-block space-y-2 w-full bg-[#101010] rounded-2xl z-10 relative px-5 py-2">
      <div class="w-full p-5">
        <div class="flex items-center space-x-2">
            <img src="https://static-cdn.jtvnw.net/emoticons/v2/emotesv2_0da7b47285284f30b8b62daaa20d0c11/default/light/1.0" alt="" class="h-6 w-6">
            <h1 class="font-bold text-3xl">Acerca de mí</h1> 
        </div>
        <p class="sm:text-lg mt-2 text-sm">Soy un programador fullstack autodidacta con una debilidad por C# y Java. Me encantan los gatos :D. También disfruto escuchar corridos y salsa mientras trabajo. Me adentro en el mundo juguetón del hacking a través de hardware y ciberseguridad, mientras juego con proyectos de código abierto. ⛄</p>
    </div>
  </div>
</div>




